{
  "rules": {
    "plaza": { ".read": false, ".write": false },
    "messages": { ".read": false, ".write": false },

    "cai-remote": { ".read": false, ".write": false },

    "cai-dl": {
      ".read": "auth != null && auth.token.email === 'opctverse@gmail.com'",
      ".write": true
    },
    "downloads_all": {
      ".read": "auth != null && auth.token.email === 'opctverse@gmail.com'",
      ".write": true
    },
    "downloads": {
      "$uid": { ".read": true, ".write": true }
    },

    "users": {
      ".read": "auth != null && auth.token.email === 'opctverse@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'opctverse@gmail.com')",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
