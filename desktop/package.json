{
  "name": "connect-ai-desktop",
  "version": "0.5.7",
  "description": "Connect AI — AI 1인 기업 OS. 에이전트 팀이 분석·기획·코딩·결재까지, 100% 로컬·무료.",
  "main": "out/main.js",
  "author": "EZER AI <opctverse@gmail.com>",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/wonseokjung/private_connectai.git"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p .",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "sim": "esbuild scripts/simulate.ts --bundle --platform=node --external:electron --outfile=out/sim.js --log-level=error && node out/sim.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/nodemailer": "^8.0.0",
    "axios": "^1.7.0",
    "electron-updater": "^6.8.3",
    "imapflow": "^1.3.7",
    "mailparser": "^3.9.9",
    "msedge-tts": "^2.0.5",
    "node-llama-cpp": "^3.18.1",
    "nodemailer": "^8.0.10"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "ai.ezer.connect-desktop",
    "productName": "Connect AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "src/renderer/**",
      "assets/**",
      "training/**",
      "package.json"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "wonseokjung",
        "repo": "connect-ai"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "vendor/llamacpp",
          "to": "llamacpp",
          "filter": [
            "mac-*/**"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "artifactName": "Connect-AI-${version}-${arch}-mac.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": {
        "teamId": "2PX39M2HZ9"
      }
    },
    "dmg": {
      "title": "Connect AI ${version}",
      "artifactName": "Connect-AI-${version}-mac-${arch}.dmg"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "vendor/llamacpp",
          "to": "llamacpp",
          "filter": [
            "win-*/**"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Connect-AI-${version}-win-x64-Setup.exe",
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon_1024.png",
      "artifactName": "Connect-AI-${version}-${arch}-linux.${ext}",
      "extraResources": [
        {
          "from": "vendor/llamacpp",
          "to": "llamacpp",
          "filter": [
            "linux-*/**"
          ]
        }
      ]
    }
  }
}
