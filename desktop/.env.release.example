# Connect AI desktop release environment template.
# Copy to a local, ignored file such as .env.release.local and fill values there.
# Do not commit real certificate, Apple ID, app-specific password, API key, or token values.

# Baseline artifact used by CI to verify parity against the shipped app.
# URL must be an https .zip URL for the current package version; SHA must be 64 hex chars.
CONNECT_AI_BASELINE_URL=https://example.com/Connect-AI-0.4.2-arm64-mac.zip
CONNECT_AI_BASELINE_SHA256=replace-with-baseline-zip-sha256
# CONNECT_AI_ZIP_SHA256=replace-with-same-baseline-zip-sha256
# CONNECT_AI_BASELINE_TOKEN=only-if-baseline-url-is-private

# GitHub repository readiness and release asset verification.
# This is mapped to GH_TOKEN by scripts/run-with-release-env.mjs and is never printed.
# Fine-grained token permissions: Metadata: read, Variables: read, Secrets: read.
CONNECT_AI_RELEASE_AUDIT_TOKEN=github-fine-grained-token-with-repo-readiness-read-permissions
# GH_TOKEN is accepted only as a process-env fallback for the same audit token contract.

# Developer ID Application certificate import.
# Use either BUILD_CERTIFICATE_PATH for local release work, or BUILD_CERTIFICATE_BASE64 for CI.
# Base64 values must decode cleanly; keep them single-line for GitHub secrets.
BUILD_CERTIFICATE_PATH=/absolute/path/DeveloperIDApplication.p12
# BUILD_CERTIFICATE_BASE64=base64-encoded-p12-for-ci
# CONNECT_AI_CERTIFICATE_PATH=/absolute/path/DeveloperIDApplication.p12
# CONNECT_AI_CERTIFICATE_BASE64=base64-encoded-p12-for-ci
P12_PASSWORD=replace-with-p12-password
# CONNECT_AI_CERTIFICATE_PASSWORD=replace-with-p12-password
KEYCHAIN_PASSWORD=replace-with-temporary-keychain-password
# CONNECT_AI_KEYCHAIN_PASSWORD=replace-with-temporary-keychain-password

# Notarization option A: App Store Connect API key.
# Use APPLE_API_KEY for a local .p8 file, or APPLE_API_KEY_BASE64 for CI.
# Base64 values must decode cleanly; keep them single-line for GitHub secrets.
APPLE_API_KEY=/absolute/path/AuthKey_KEYID.p8
# APPLE_API_KEY_BASE64=base64-encoded-p8-for-ci
APPLE_API_KEY_ID=replace-with-key-id
APPLE_API_ISSUER=replace-with-issuer-uuid

# Notarization option B: Apple ID and app-specific password.
# APPLE_ID=apple-id@example.com
# APPLE_APP_SPECIFIC_PASSWORD=replace-with-app-specific-password
# APPLE_TEAM_ID=2PX39M2HZ9

# Notarization option C: notarytool keychain profile already stored on this machine.
# Local-only unless the profile is created on the release runner; prefer option A or B for GitHub-hosted CI.
# APPLE_KEYCHAIN_PROFILE=connect-ai-notary
